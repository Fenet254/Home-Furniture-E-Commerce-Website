generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  kind         String
  priceCents   Int
  widthCm      Int
  depthCm      Int
  heightCm     Int
  seats        Int?
  deliveryDays Int
  stock        Int      @default(0)
  eco          Boolean  @default(false)
  description  String
  colors       Color[]
  materials    Material[]
  rooms        String[]
  moods        String[]
  styles       String[]
}

model Color    { id String @id @default(cuid()); name String; hex String; productId String; product Product @relation(fields: [productId], references: [id]) }
model Material { id String @id @default(cuid()); name String; note String; priceDeltaCents Int @default(0); productId String; product Product @relation(fields: [productId], references: [id]) }

model User {
  id      String       @id @default(cuid())
  email   String       @unique
  name    String?
  orders  Order[]
  designs RoomDesign[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  status    String      @default("confirmed")
  totalCents Int
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id])
  productId  String
  color      String
  material   String
  qty        Int
  unitCents  Int
}

model RoomDesign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  data      Json     // same shape the RoomVerse store already saves
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
}
